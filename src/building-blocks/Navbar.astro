---
import { siteConfig } from '../config/site';
import NavbarLink from './NavbarLink.astro';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 border-b border-accent bg-black/40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-6">    
      <div class="flex flex-col md:flex-row gap-2 items-center justify-between py-4 md:py-6">
        <a href="/" class="group flex items-center gap-2">
          <Logo class="h-7 w-7" />
          <span class="text-xl font-medium tracking-tight text-white group-hover:text-accent">koolcodez</span>
        </a>
        <nav class="flex gap-4 md:gap-8 items-center">
            {siteConfig.navigation.map((link) => (
                <NavbarLink href={link.href}>{link.name}</NavbarLink>
            ))}
        </nav>
      </div>
</div>
  </header>
  
  