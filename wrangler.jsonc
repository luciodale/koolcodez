{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koolcodez",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SolarSystem"] },
    { "tag": "v2", "deleted_classes": ["SolarSystem"] }
  ]
}
